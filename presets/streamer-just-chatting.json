            "kind": "brand",
            "value": "obs"
          },
          "action": {
            "type": "run_command",
            "commandId": "cmd-streamer-just-chatting-obs",
            "shell": "powershell",
            "runInTerminal": false
          },
          "updatedAt": "2026-08-26T12:00:00.000Z"
        },
        {
          "id": "btn-streamer-just-chatting-mascota",
